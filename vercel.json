{
  "regions": ["hkg1"],
  "crons": [
    { "path": "/api/cron/line-daily", "schedule": "0 1 * * *" },
    { "path": "/api/cron/line-upcoming", "schedule": "*/15 * * * *" }
  ],
  "rewrites": [
    { "source": "/api/appointments", "destination": "/api/sql-read?route=appointments" },
    { "source": "/api/customers", "destination": "/api/sql-read?route=customers" },
    { "source": "/api/schedules", "destination": "/api/sql-read?route=schedules" },
    { "source": "/api/reports", "destination": "/api/sql-read?route=reports" }
  ],
  "headers": [
    {
      "source": "/(app|report-accounting-patch|remittance-fields-patch).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(styles|tailwind.generated).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  }
}
