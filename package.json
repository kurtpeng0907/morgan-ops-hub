{
  "name": "morgan-ops-hub",
  "private": true,
  "version": "3.1.0",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./tailwind.generated.css --minify",
    "dev:mock": "node tests/mock-server.js",
    "check": "node scripts/check-js.js",
    "test": "node --test tests/*.test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-sql.js",
    "db:export-sheets": "node scripts/export-sheets-snapshot.js",
    "db:import": "node scripts/import-sheets.js",
    "db:verify": "node scripts/verify-migration.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.2",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.44.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.4",
    "pg": "^8.23.0",
    "tailwindcss": "3.4.17"
  }
}
